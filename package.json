{
  "name": "simple-image-crop",
  "displayName": "Image Editor: Simple Crop",
  "description": "Fast & intuitive image cropping, resizing, annotations (shapes, text, arrows), and direct overwrite saving. / 直感的なトリミング・リサイズ・図形やテキスト・矢印などの注釈追加に対応し、元ファイルに直接上書き保存します。",
  "version": "1.6.0",
  "publisher": "globalpaws",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "scripts": {
    "lint": "node -c extension.js && node test/verify-webview.js",
    "lint:fix": "node -c extension.js && node test/verify-webview.js",
    "test": "node test/verify-webview.js",
    "package": "vsce package",
    "package:vsix": "vsce package --allow-missing-repository"
  },
  "keywords": [
    "crop",
    "image",
    "image-editor",
    "trim",
    "overwrite",
    "excel-crop",
    "resize",
    "zoom",
    "circle-crop",
    "rotate",
    "rounded-corners",
    "image-crop",
    "shapes",
    "text",
    "arrow",
    "markup",
    "annotation"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "simple-image-crop.crop",
        "title": "Image Editor: Simple Crop"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "simple-image-crop.crop",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|webp|bmp)$/i",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "simple-image-crop.crop",
          "when": "resourceExtname =~ /\\.(png|jpg|jpeg|webp|bmp)$/i",
          "group": "navigation@1"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "simple-image-crop.editor",
        "displayName": "Image Editor: Simple Crop",
        "selector": [
          {
            "filenamePattern": "*.{png,jpg,jpeg,webp,bmp}"
          }
        ],
        "priority": "option"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GlobalPaws/vscode-image-editor.git"
  },
  "bugs": {
    "url": "https://github.com/GlobalPaws/vscode-image-editor/issues"
  },
  "homepage": "https://github.com/GlobalPaws/vscode-image-editor#readme",
  "license": "MIT",
  "author": {
    "name": "GlobalPaws",
    "url": "https://github.com/GlobalPaws"
  },
  "qna": "https://github.com/GlobalPaws/vscode-image-editor/issues"
}